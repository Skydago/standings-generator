{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VGC Standings Generator",
  "version": "1.0.2",
  "identifier": "com.cuccu.vgc-standings",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VGC Standings Generator",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdENzc2RUVDNzBFNDc5MzAKUldRd2VlUnc3RzUzZlhxNkJPNzNPdjZVd1FyWHg2MUVibDhXSWxRcDkzSEpoSyt1UXdnVDFISTcK",
      "endpoints": [
        "https://github.com/Skydago/standings-generator/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
